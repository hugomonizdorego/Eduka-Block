#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if [ -x /usr/lib/eduka-block/eduka-block-helper ]; then
            /usr/lib/eduka-block/eduka-block-helper cleanup-system </dev/null >/dev/null 2>&1 || true
        fi
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable --now eduka-block-sync.timer >/dev/null 2>&1 || true
            systemctl disable --now eduka-block-firewall.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
